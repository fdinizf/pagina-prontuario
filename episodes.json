{
  "version": 1,
  "description": "Catálogo de metadados dos áudios. Os padrões são avaliados na ordem apresentada; episódios sem correspondência ficam em Outros.",
  "modules": [
    "HMEC (Emergências Clínicas)",
    "TOCE (Clínica Cirúrgica e Trauma)",
    "PMSUS (Atenção Primária e Ambulatório)",
    "NCS",
    "Outros"
  ],
  "rules": [
    {"match":"^(HMEC\\.-\\.(BLS|ACLS))|farmacologia_da_parada|cuidados\\.pos-pcr|salvando\\.cerebro|obstrucao\\.de\\.vias","module":"HMEC (Emergências Clínicas)","submodule":"Parada Cardiorrespiratória"},
    {"match":"sepse","module":"HMEC (Emergências Clínicas)","submodule":"Sepse"},
    {"match":"^Diretriz Brasileira de SCA 2025 - pt [12]\\.m4a$","module":"HMEC (Emergências Clínicas)","submodule":"Cardiologia"},
    {"match":"^IAM\\.","module":"HMEC (Emergências Clínicas)","submodule":"Cardiologia"},
    {"match":"sindromes\\.hipertensivas\\.na\\.gestacao","module":"HMEC (Emergências Clínicas)","submodule":"Emergências Obstétricas (Síndromes Hipertensivas)"},
    {"match":"intoxic|abordagem\\.geral\\.das\\.intoxic","module":"HMEC (Emergências Clínicas)","submodule":"Toxicologia (Intoxicações Exógenas)"},
    {"match":"crise\\.convulsiva","module":"HMEC (Emergências Clínicas)","submodule":"Neurologia de Emergência"},
    {"match":"^TOCE.*(abdome\\.(agudo|obstrutivo|isquemico)|volvo\\.sigmoide)","module":"TOCE (Clínica Cirúrgica e Trauma)","submodule":"Abdome Agudo (Geral, Obstrutivo e Vascular)"},
    {"match":"^TOCE.*(apendicite|colecistite|diverticulite|pancreatite)","module":"TOCE (Clínica Cirúrgica e Trauma)","submodule":"Abdome Agudo Inflamatório (Apendicite, Colecistite, Diverticulite e Pancreatite)"},
    {"match":"^TOCE.*hemorragia_digestiva","module":"TOCE (Clínica Cirúrgica e Trauma)","submodule":"Hemorragia Digestiva"},
    {"match":"^TOCE.*hernia\\.inguinal","module":"TOCE (Clínica Cirúrgica e Trauma)","submodule":"Hérnias da Parede Abdominal"},
    {"match":"^TOCE.*CA\\.(de\\.)?(esofago|estomago|colorretal)","module":"TOCE (Clínica Cirúrgica e Trauma)","submodule":"Oncologia Gastrointestinal"},
    {"match":"^TOCE.*queimados|^xABCDE","module":"TOCE (Clínica Cirúrgica e Trauma)","submodule":"Trauma e Queimados"},
    {"match":"armadilhas\\.fisiologicas","module":"TOCE (Clínica Cirúrgica e Trauma)","submodule":"Cirurgia Pediátrica"},
    {"match":"^TOCE","module":"TOCE (Clínica Cirúrgica e Trauma)","submodule":"Abdome Agudo (Geral, Obstrutivo e Vascular)"},
    {"match":"^PMSUS.*diretriz\\.brasileira","module":"PMSUS (Atenção Primária e Ambulatório)","submodule":"Hipertensão Arterial (Diretriz Brasileira 2025 / AHA 2026)"},
    {"match":"^PMSUS.*(hipotire|nodulos\\.tire)","module":"PMSUS (Atenção Primária e Ambulatório)","submodule":"Endocrinologia Tireoidiana"},
    {"match":"^PMSUS.*(crescimento|puberdade)","module":"PMSUS (Atenção Primária e Ambulatório)","submodule":"Crescimento e Desenvolvimento Infantil"},
    {"match":"^Epilepsia\\.PCDT","module":"PMSUS (Atenção Primária e Ambulatório)","submodule":"Neurologia Ambulatorial"},
    {"match":"^NCS\\.-\\.SP\\.1\\.1","module":"NCS","complex":"NCS complexo 1","submodule":"SP 1.1 – Arritmias e Fibrilação Atrial"},
    {"match":"^NCS\\.-\\.SP\\.1\\.2","module":"NCS","complex":"NCS complexo 1","submodule":"SP 1.2 – Síndromes Coronarianas Agudas (IAM)"},
    {"match":"^NCS\\.-\\.SP\\.1\\.3","module":"NCS","complex":"NCS complexo 1","submodule":"SP 1.3 – Emergências Hipertensivas"},
    {"match":"^NCS\\.-\\.SP\\.1\\.4","module":"NCS","complex":"NCS complexo 1","submodule":"SP 1.4 – Síndromes Hipertensivas na Gestação e HELLP"},
    {"match":"^NCS\\.-\\.SP\\.1\\.5","module":"NCS","complex":"NCS complexo 1","submodule":"SP 1.5 – Emergências Respiratórias e PCR em Pediatria"},
    {"match":"^NCS\\.-\\.SP\\.2\\.2","module":"NCS","complex":"NCS complexo 2","submodule":"SP 2.2 – Síndrome de Cushing"},
    {"match":"^NCS\\.-\\.(2\\.1|2\\.2)","module":"NCS","complex":"NCS complexo 2","submodule":"SP 2.1 e 2.2 – Diabetes Mellitus e Complicações Agudas"},
    {"match":"^NCS\\.-\\.SP\\.2\\.3","module":"NCS","complex":"NCS complexo 2","submodule":"SP 2.3 – Síndrome Metabólica e Transtornos Alimentares"},
    {"match":"^NCS\\.-\\.SP\\.2\\.4","module":"NCS","complex":"NCS complexo 2","submodule":"SP 2.4 – Síndrome dos Ovários Policísticos (SOP)"},
    {"match":"^(NCS\\.-\\.)?SP\\.3\\.1","module":"NCS","complex":"NCS complexo 3","submodule":"SP 3.1 – Dermatologia Infecciosa (Herpes Zoster e Hanseníase)"},
    {"match":"^(NCS\\.-\\.)?SP\\.3\\.2","module":"NCS","complex":"NCS complexo 3","submodule":"SP 3.2 – Doenças Exantemáticas na Infância"},
    {"match":"^(NCS\\.-\\.)?SP\\.3\\.3","module":"NCS","complex":"NCS complexo 3","submodule":"Reumatologia (Lúpus Eritematoso Sistêmico)"},
    {"match":"^(NCS\\.-\\.)?SP\\.3\\.4","module":"NCS","complex":"NCS complexo 3","submodule":"SP 3.4 – Psoríase"}
  ],
  "titles": {
    "HMEC.-.Cuidados.pos-PCR.m4a": "Cuidados pós-PCR",
    "HMEC.-.Salvando.cerebro.pos-PRC.m4a": "Salvando cérebro pós-PCR",
    "TOCE.-.Adbome.obstrutivo.m4a": "Abdome obstrutivo",
    "TOCE-.abdome.isquemico.m4a": "Abdome isquêmico",
    "TOCE.-.Manejo.de.colecisite.aguda.m4a": "Manejo de colecistite aguda",
    "TOCE.-.Sintomas.e.diagnostico.da.Pancreatite.aguda_.m4a": "Sintomas e diagnóstico da pancreatite aguda",
    "PMSUS.-.Hipotireodismo.clinico.e.subclinico.-.Diagnostico.m4a": "Hipotireoidismo clínico e subclínico — diagnóstico",
    "PMSUS.-.Hipotireodismo.-.manejo.m4a": "Hipotireoidismo — manejo",
    "PMSUS.-.Nodulos.tireodeos.-.diagnostico.e.manejo.m4a": "Nódulos tireoidianos — diagnóstico e manejo",
    "NCS.-.2.1.-.DM.1.e.2.-.tratamento.m4a": "Diabetes mellitus — tratamento",
    "NCS.-.2.1.-.DM.1.m4a": "Diabetes mellitus — parte 1",
    "NCS.-.2.1.-.DM.2.m4a": "Diabetes mellitus — parte 2",
    "NCS.-.SP.2.3.-.Bulimina.nervosa.m4a": "Bulimia nervosa",
    "NCS.-.SP.2.3.-.compulsao.alimentar.m4a": "Compulsão alimentar",
    "NCS.-.SP.2.3.-.Sindrome.metabolica.m4a": "Síndrome metabólica",
    "Epilepsia.PCDT.m4a": "Epilepsia — PCDT",
    "SP 3.4 - Psoríase pt 1.m4a": "SP 3.4 – Psoríase — parte 1",
    "SP 3.4 - Psoríase pt 2.m4a": "SP 3.4 – Psoríase — parte 2",
    "SP 3.4 - Psoríase pt 3.m4a": "SP 3.4 – Psoríase — parte 3",
    "Diretriz Brasileira de SCA 2025 - pt 1.m4a": "Diretriz Brasileira de SCA 2025 — parte 1",
    "Diretriz Brasileira de SCA 2025 - pt 2.m4a": "Diretriz Brasileira de SCA 2025 — parte 2"
  }
}
